# Lutra Environment Variables
# Copy this file and add your actual credentials:
#   System-wide install: /etc/lutra/.env
#   User install:        ~/.config/lutra/.env
# IMPORTANT: Never commit the real .env file to version control!

# PostgreSQL passwords, one variable per password_env used in lutra.yaml
POSTGRES_PASSWORD=your-postgres-password-here
CRITICAL_DB_PASSWORD=your-critical-db-password

# Optional Discord incoming webhook URL (treat it as a credential)
# LUTRA_DISCORD_WEBHOOK=https://discord.com/api/webhooks/replace-me

# Security Notes:
# - This file should have mode 600 (chmod 600 .env)
# - Only the user running lutra should be able to read it
# - Add .env to .gitignore
# - Environment variable names are referenced in lutra.yaml via password_env
# - Rotate a Discord webhook immediately if its URL is exposed
